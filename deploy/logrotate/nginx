# Replaces /etc/logrotate.d/nginx (the distribution's file covers the same logs; two files for
# one log make logrotate fail). Not yet run on a server (no logrotate on the dev machine);
# check with `logrotate -d /etc/logrotate.d/nginx`.
# nginx logs hold visitor IPs (privacy policy: kept at most 14 days). Rotated daily, 13 old
# files plus today's, so no line is older than 14 days; maxage removes leftovers.
/var/log/nginx/*.log {
    daily
    rotate 13
    maxage 14
    missingok
    notifempty
    compress
    delaycompress
    sharedscripts
    create 0640 www-data adm
    postrotate
        invoke-rc.d nginx rotate >/dev/null 2>&1 || true
    endscript
}
