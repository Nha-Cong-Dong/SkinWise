# Copy to .env and replace <password> with the Postgres password chosen during install.
DATABASE_URL=postgresql+psycopg://postgres:<password>@localhost:5432/skinwise
TEST_DATABASE_URL=postgresql+psycopg://postgres:<password>@localhost:5432/skinwise_test
# Optional: AI myth card drafts on the review page (#review). Without it, drafting answers 503.
# ANTHROPIC_API_KEY=sk-ant-...
# DRAFT_MODEL=claude-opus-5-5
# The same key enables reading ingredient lists off label photos (each photo is a billed call).
# LABEL_MODEL=claude-opus-5-5
# Hackathon gateway key instead (Anthropic Messages API, claude-haiku-5-5 only, $5, expires 10/11):
# ANTHROPIC_BASE_URL=https://proptit.dekthe.dev
# DRAFT_MODEL=claude-haiku-5-5
# LABEL_MODEL=claude-haiku-5-5
# User accounts (plan/h-accounts.md). Verify and reset links point to APP_URL; the session cookie is Secure when it is https.
# APP_URL=http://localhost:5173
# LOGIN_EMAIL_MODE=dev   # default: no email is sent, verify / reset links are logged and shown on the page
# Real email over SMTP. Example: Gmail with an App Password (Google account > Security >
# 2-Step Verification > App passwords; the normal Gmail password does not work).
# Gmail stores data outside Vietnam (Art. 20, Law 91/2025/QH15) and plan/h-accounts.md picks an
# email service based in Vietnam: use this only to try with your own mailbox until the legal
# part is done. Without SMTP_HOST or SMTP_FROM, sign-up answers 503.
# LOGIN_EMAIL_MODE=smtp
# SMTP_HOST=smtp.gmail.com
# SMTP_SECURITY: starttls (port 587) | ssl (port 465) | none
# SMTP_PORT=587
# SMTP_SECURITY=starttls
# SMTP_USERNAME=you@gmail.com
# The 16-letter App Password; never logged.
# SMTP_PASSWORD=abcdefghijklmnop
# SMTP_FROM=SkinWise <you@gmail.com>
# APP_URL must be the address users open (links in the emails point there).
